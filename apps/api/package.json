{
  "name": "@skillonx/survey-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "seed": "knex --knexfile knexfile.cjs seed:run",
    "seed:student-lms-e2e": "tsx src/scripts/seedStudentLmsE2e.ts",
    "seed:lab-management": "tsx src/scripts/seedLabManagement.ts",
    "seed:maintenance": "tsx src/scripts/seedMaintenance.ts",
    "seed:admissions-qa": "tsx src/scripts/seedAdmissionsQa.ts",
    "seed:e2e-mobile-users": "tsx src/scripts/seedE2eMobileUsers.ts",
    "seed:live-qa": "tsx src/scripts/seedLiveQa.ts",
    "seed:office-qa": "tsx src/scripts/seedOfficeQa.ts",
    "seed:parent-alumni-qa": "tsx src/scripts/seedParentAlumniQa.ts",
    "seed:iqac-qa": "tsx src/scripts/seedIqacQa.ts",
    "seed:uat": "tsx src/scripts/seedUat.ts",
    "backfill:alumni-360": "tsx src/scripts/backfillAlumni360.ts",
    "perf:alumni-360": "tsx src/scripts/perfAlumni360.ts",
    "perf:alumni-crm": "tsx src/scripts/perfAlumniCrm.ts",
    "perf:alumni-intel": "tsx src/scripts/perfAlumniIntel.ts",
    "perf:alumni-engagement": "tsx src/scripts/perfAlumniEngagement.ts",
    "perf:alumni-matching": "tsx src/scripts/perfAlumniMatching.ts",
    "perf:alumni-recognition": "tsx src/scripts/perfAlumniRecognition.ts",
    "perf:alumni-impact": "tsx src/scripts/perfAlumniImpact.ts",
    "perf:alumni-assistant": "tsx src/scripts/perfAlumniAssistant.ts",
    "test": "node --import tsx --test --test-concurrency=1 $(find src -name '*.test.ts')",
    "test:alumni": "node --import tsx --test --test-concurrency=1 src/modules/alumni/*.test.ts",
    "test:alumni-crm": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniCrm.e2e.test.ts src/modules/alumni/alumni360.e2e.test.ts src/modules/alumni/alumni.e2e.test.ts",
    "test:alumni-intel": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniIntel.e2e.test.ts src/modules/alumni/alumniCrm.e2e.test.ts src/modules/alumni/alumni360.e2e.test.ts src/modules/alumni/alumni.e2e.test.ts",
    "test:alumni-engagement": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniIntel.e2e.test.ts src/modules/alumni/alumniCrm.e2e.test.ts src/modules/alumni/alumni360.e2e.test.ts src/modules/alumni/alumni.e2e.test.ts src/modules/alumni/alumniEngagement.e2e.test.ts",
    "test:alumni-matching": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniMatching.e2e.test.ts",
    "test:alumni-recognition": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniRecognition.e2e.test.ts",
    "test:alumni-impact": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniImpact.e2e.test.ts",
    "test:alumni-assistant": "node --import tsx --test --test-concurrency=1 src/modules/alumni/alumniAssistant.e2e.test.ts",
    "test:alumni-c1-c5": "node --import tsx --test --test-concurrency=1 src/modules/alumni/*.test.ts",
    "test:alumni-c1-c6": "node --import tsx --test --test-concurrency=1 src/modules/alumni/*.test.ts",
    "test:alumni-c1-c7": "node --import tsx --test --test-concurrency=1 src/modules/alumni/*.test.ts",
    "test:alumni-c1-c8": "node --import tsx --test --test-concurrency=1 src/modules/alumni/*.test.ts",
    "import:quiz-bank": "tsx src/scripts/importQuestionBank.ts",
    "import:assignment-bank": "tsx src/scripts/importAssignmentBank.ts",
    "expand:assignment-banks": "tsx src/scripts/expandAssignmentBanks.ts",
    "map:quiz-co": "tsx src/scripts/mapQuizQuestionCos.ts",
    "map:assignment-co": "tsx src/scripts/remapAssignmentQuestionCos.ts",
    "map:quiz-questions-co": "tsx src/scripts/mapQuizQuestionCos.ts",
    "import:lesson-plan": "tsx src/scripts/importLessonPlan.ts",
    "import:academic-content": "tsx src/scripts/importAcademicContent.ts",
    "import:co-po": "tsx src/scripts/importCopoMaster.ts",
    "import:academic-mappings": "tsx src/scripts/importCopoMaster.ts",
    "import:gap-master": "tsx src/scripts/importGapMaster.ts",
    "import:cbs-master": "tsx src/scripts/importCbsMaster.ts",
    "import:academic-master": "tsx src/scripts/importCbsMaster.ts",
    "import:co-evaluation": "tsx src/scripts/importCoEvalMaster.ts",
    "import:previous-year-qps": "tsx src/scripts/importPreviousYearQps.ts",
    "rebuild:pyq-master": "node --import tsx src/scripts/rebuildPyqMasterExcel.ts",
    "report:pyq-qa": "node --import tsx src/scripts/pyqReports.ts",
    "export:seed-snapshot": "tsx src/scripts/exportSeedSnapshot.ts",
    "export:academic-master-json": "tsx src/scripts/exportAcademicMasterJson.ts",
    "seed:academic-master": "node scripts/seed-academic-master.cjs",
    "seed:academic-master:validate": "node scripts/validate-academic-master.cjs",
    "seed:academic-master:dry-run": "node scripts/seed-academic-master.cjs --dry-run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "nanoid": "^5.1.0",
    "pdfjs-dist": "^6.2.108",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
